generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Creator {
  id                String   @id @default(uuid())
  username          String   @unique
  wallet            String   @unique
  profileImageUrl   String?
  bio               String?
  xAccount          String?
  launchedTokenMint String?
  launchedTokenName String?
  launchedTokenSymbol String?
  launchedTokenUrl  String?
  launchedTokenAt   DateTime?
  createdAt         DateTime @default(now())
  slots             Slot[]
  bookings          Booking[]
}

model Slot {
  id        String   @id @default(uuid())
  creator   Creator  @relation(fields: [creatorId], references: [id])
  creatorId String
  startTime DateTime
  endTime   DateTime
  price     Float
  currency  Currency @default(SOL)
  status    String   @default("available")
  meetLink  String?
  booking   Booking?
}

model Booking {
  id          String   @id @default(uuid())
  slot        Slot     @relation(fields: [slotId], references: [id])
  slotId      String   @unique
  creator     Creator  @relation(fields: [creatorId], references: [id])
  creatorId   String
  payerWallet String
  amountSol   Float
  amount      Float    @default(0)
  currency    Currency @default(SOL)
  txSignature String?  @map("tx_signature")
  status      String   @default("confirmed")
  name        String?
  email       String?
  callFor     String?
  signature   String?
  accessToken String?
  createdAt   DateTime @default(now())
}

model KiraPayment {
  id             String   @id @default(uuid())
  customOrderId  String   @unique
  slotId         String
  creatorId      String
  payerWallet    String
  receiverWallet String
  checkoutUrl    String?
  checkoutCode   String?
  originalPrice  Int
  fiatCurrency   String
  status         String   @default("pending")
  providerStatus String?
  bookingId      String?
  rawPayload     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum Currency {
  SOL
  PUSD
}
